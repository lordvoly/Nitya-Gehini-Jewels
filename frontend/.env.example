# Our own backend API.
# Local dev: http://localhost:4000 (also the built-in fallback if unset)
# Production: your Render service URL, e.g. https://ngj-backend.onrender.com
VITE_API_URL=http://localhost:4000

# Supabase project (safe for the frontend — anon key only, used for Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
